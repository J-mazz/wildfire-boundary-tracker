/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {{IMAGERY_ORIGIN}}; connect-src 'self' {{IMAGERY_ORIGIN}} https://tiles.openfreemap.org; font-src 'self'; worker-src 'self' blob:; child-src blob:
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/map.html
  Cache-Control: public, max-age=0, must-revalidate

/client.js
  Cache-Control: public, max-age=0, must-revalidate

/client.css
  Cache-Control: public, max-age=0, must-revalidate

/data/catalog.json
  Cache-Control: public, max-age=0, must-revalidate

/data/context/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/firms/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/sam2/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/sentinel/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/data/geosplat/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/wasm/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
